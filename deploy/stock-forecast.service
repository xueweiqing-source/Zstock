[Unit]
Description=Stock Forecast Web (Flask + gunicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/stock-forecast
# 凭据从环境文件注入（install.sh 生成，权限 600，不入库）
# 必填：SF_ADMIN_PASSWORD；可选：SF_SECRET_KEY、SF_ADMIN_USER、LLM_API_BASE、LLM_API_KEY、LLM_MODEL
EnvironmentFile=-/etc/stock-forecast.env
Environment=SF_URL_PREFIX=/forecast
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/stock-forecast/venv/bin/gunicorn \
    -b 127.0.0.1:8501 \
    -w 1 --threads 4 --timeout 60 \
    --access-logfile /var/log/stock-forecast-access.log \
    --error-logfile /var/log/stock-forecast-error.log \
    webapp:app
Restart=always
RestartSec=3
# 资源护栏（主机内存 2G，需克制）
MemoryMax=400M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target

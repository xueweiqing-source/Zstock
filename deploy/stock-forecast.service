[Unit]
Description=Stock Forecast Web (Flask + gunicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/stock-forecast
Environment=SF_SECRET_KEY=CHANGE_ME_ON_INSTALL
Environment=SF_ADMIN_USER=admin
Environment=SF_ADMIN_PASSWORD=Xiaoqing@123
Environment=SF_URL_PREFIX=/forecast
Environment=PYTHONUNBUFFERED=1
# LLM 研判（不配置则降级为规则叙事）
Environment=LLM_API_BASE=
Environment=LLM_API_KEY=
Environment=LLM_MODEL=deepseek-chat
ExecStart=/var/www/stock-forecast/venv/bin/gunicorn \
    -b 127.0.0.1:8501 \
    -w 1 --threads 4 --timeout 60 \
    --access-logfile /var/log/stock-forecast-access.log \
    --error-logfile /var/log/stock-forecast-error.log \
    webapp:app
Restart=always
RestartSec=3
# 资源护栏（主机内存 2G，需克制）
MemoryMax=400M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
